  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Customer Journey (Ordering & Ingress)",
      "items": [
        "1. Ingress: Customer sends HTTP POST to Flask /agent/chat or loads dedicated /chat UI.",
        "2. AI Routing: Strands Decider 2B evaluates input dynamically with #tool-selection.",
        "3. Domain Logic: order_tool_node extracts items, parses delivery/pickup, and handles upselling (+50 EGP combo).",
        "4. Entity Disambiguation: Fuzzy resolution prevents guessing between Smouha Branch 1 & 2.",
        "5. Database Commit: commit_confirmed_order inserts Customer, Order, and OrderItem rows in SQLite.",
        "6. Verification: Authoritative ORD-XXXXXX receipt returned directly from SQLite; deterministic paths bypass external LLMs entirely."
      ]
    },
    {
      "dot": "violet",
      "title": "Multi-Provider AI Architecture (Bedrock Primary + Gemini Fallback)",
      "items": [
        "Strands Decider 2B SLM: In-process PyTorch CPU singleton classifying intent across 5 structured tools.",
        "Amazon Bedrock (Primary): amazon.nova-lite-v1:0 in eu-north-1 via Converse API (retries=1, 10s fail-fast timeout).",
        "Google Gemini 2.5 Flash (Fallback): Cloud LLM invoked automatically when Bedrock is unavailable, throttled, or times out.",
        "Grounding Firewall: Both LLMs receive verified context from SQLite & ChromaDB; prompt-injection and hallucinated order numbers are strictly guarded."
      ]
    },
    {
      "dot": "amber",
      "title": "Resilience, Circuit-Breaker & Live Quota Handling",
      "items": [
        "Bedrock Throttling Circuit-Breaker: When Bedrock returns ThrottlingException (e.g. daily token quota exhausted in eu-north-1), a 60-second cooldown is engaged.",
        "Zero Extra Latency on Cooldown: Subsequent turns skip Bedrock instantly (0ms) and route directly to Gemini fallback.",
        "Decider Fallback: Deterministic regex/rule dispatcher takes over if PyTorch Decider 2B is disabled or errors.",
        "Order Idempotency: LLM provider fallback occurs strictly after tool execution; cart mutations and order commits never run twice."
      ]
    },
    {
      "dot": "cyan",
      "title": "Data Isolation & Cloud Egress Boundaries",
      "items": [
        "Untrusted Zone: Browser traffic enters exclusively through Flask routes (/chat, /admin, /agent/chat).",
        "In-Process Zone: Python dispatcher, SQLite, and ChromaDB execute locally with zero external network exposure.",
        "Cloud Egress: Only generative synthesis communicates over HTTPS to AWS Bedrock (primary) and Google Gemini (fallback)."
      ]
    }
  ]
