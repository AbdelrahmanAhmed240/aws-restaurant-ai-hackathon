  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Customer Journey (Ordering)",
      "items": [
        "1. Ingress: Customer sends HTTP POST to Flask /agent/chat endpoint.",
        "2. AI Routing: Strands Decider 2B evaluates input dynamically with #tool-selection.",
        "3. Domain Logic: order_tool_node extracts items, parses delivery/pickup, and handles upselling (+50 EGP combo).",
        "4. Entity Disambiguation: Fuzzy resolution prevents guessing between Smouha Branch 1 & 2.",
        "5. Database Commit: commit_confirmed_order inserts Customer, Order, and OrderItem rows in SQLite.",
        "6. Verification: Authoritative ORD-XXXXXX receipt returned directly from SQLite with Gemini conversational synthesis."
      ]
    },
    {
      "dot": "violet",
      "title": "Decoupled AI Architecture",
      "items": [
        "Strands Decider 2B SLM: PyTorch CPU singleton classifying intent across 5 structured tools.",
        "Google Gemini 2.5 Flash: Cloud LLM via official google-genai SDK for natural language responses.",
        "Grounding Firewall: Gemini is strictly provided verified facts from SQLite and ChromaDB chunks.",
        "Zero Hallucination: Order codes are never generated by the LLM."
      ]
    },
    {
      "dot": "amber",
      "title": "Resilience & Fallback Architecture",
      "items": [
        "Decider Fallback: Deterministic regex/rule dispatcher takes over if SLM is disabled or errors.",
        "RAG Fallback: Keyword search scans Markdown files if ChromaDB embeddings encounter rate limits.",
        "Phone Validation: Regex enforces strict Egyptian mobile format (010, 011, 012, 015).",
        "Order Idempotency: Duplicate confirmation submissions replay existing order receipt without duplicate rows."
      ]
    },
    {
      "dot": "cyan",
      "title": "Data Isolation & Boundaries",
      "items": [
        "Untrusted Zone: Browser traffic enters exclusively through Flask routes (/agent/chat, /dashboard).",
        "In-Process Zone: Python dispatcher, SQLite, and ChromaDB execute locally with zero network exposure.",
        "Cloud Egress: Only Gemini generative synthesis communicates over HTTPS with API key credentials."
      ]
    }
  ]
}