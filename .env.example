# Flask Configuration
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration (SQLite by default)
DATABASE_URI=sqlite:///restaurant.db

# Google Gemini API Configuration (Sole LLM Provider)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Verified Gemini generation models: gemini-2.5-flash (recommended default), gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
# Official Gemini embedding model for RAG: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Vector Database (ChromaDB local persistence)
CHROMA_PERSIST_DIR=./data/chroma_db

# Agent defaults for future LangGraph/LLM usage
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=512

# Strands Decider 2B Execution Mode
# DECIDER_ENABLED=True keeps Strands Decider 2B neural model active for all normal intent classification requests
# PRELOAD_DECIDER=True loads the model during startup before accepting chat requests
# DECIDER_THREADS=0 uses all available CPU threads (or set e.g. 4-8 for thermal control)
DECIDER_ENABLED=True
PRELOAD_DECIDER=True
DECIDER_THREADS=0
